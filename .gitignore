# ==============================================================================
# WebSpire Labs — Git Ignore Configuration (.gitignore)
# ==============================================================================

# Videos directory & large video assets
/videos/
*.mp4
*.webm
*.mov
*.avi
*.mkv

# OS Metadata
.DS_Store
Thumbs.db
desktop.ini

# IDE & Editor files
.vscode/
.idea/
*.swp
*.swo

# Node & Local Development Scripts
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
