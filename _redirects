# Netlify Redirects Configuration for WebSpire Labs
# This file provides clean URLs (no .html extension) on Netlify CDN

# Canonical Index Redirect
/index.html             /                        301!

# 301 Permanent Redirects: .html -> Clean URL
/service.html           /services                301!
/service                /services                301!
/about.html             /about                   301!
/services.html          /services                301!
/web-development.html   /web-development         301!
/blog.html              /blog                    301!
/blog-detail.html       /blog-detail             301!
/contact.html           /contact                 301!

# 200 Internal Rewrites: Serve .html file under clean URL
/about                  /about.html              200
/services               /services.html           200
/web-development        /web-development.html    200
/blog                   /blog.html               200
/blog-detail            /blog-detail.html        200
/contact                /contact.html            200
